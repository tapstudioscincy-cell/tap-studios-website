<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>T.A.P Studios | Photography</title>
  <style>
    body {
      margin: 0;
      font-family: Arial, sans-serif;
      background: #111;
      color: white;
    }

    header {
      background: #000;
      padding: 25px;
      text-align: center;
    }

    header h1 {
      margin: 0;
      font-size: 2.3rem;
    }

    nav {
      background: #222;
      padding: 15px;
      text-align: center;
    }

    nav a {
      color: white;
      margin: 10px;
      text-decoration: none;
      font-weight: bold;
    }

    .hero {
      padding: 70px 20px;
      text-align: center;
      background: linear-gradient(to right, #000, #333);
    }

    .hero h2 {
      font-size: 2.5rem;
    }

    .btn {
      display: inline-block;
      background: white;
      color: black;
      padding: 14px 25px;
      margin: 10px;
      border-radius: 8px;
      text-decoration: none;
      font-weight: bold;
    }

    section {
      padding: 50px 20px;
      max-width: 1100px;
      margin: auto;
    }

    .grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(230px, 1fr));
      gap: 20px;
    }

    .card {
      background: #1d1d1d;
      padding: 25px;
      border-radius: 12px;
      border: 1px solid #333;
    }

    .card h3 {
      margin-top: 0;
    }

    form input,
    form select,
    form textarea {
      width: 100%;
      padding: 13px;
      margin: 10px 0;
      border-radius: 6px;
      border: none;
    }

    footer {
      background: #000;
      text-align: center;
      padding: 30px;
      color: #aaa;
    }
  </style>
</head>

<body>

<header>
  <h1>T.A.P Studios</h1>
  <p>Affordable Photos. Great Quality. Fast Turnaround.</p>
</header>

<nav>
  <a href="#home">Home</a>
  <a href="#sessions">Sessions</a>
  <a href="#booking">Booking</a>
  <a href="#gallery">Gallery</a>
  <a href="#clientportal">Client Portal</a>
  <a href="#rewards">Rewards</a>
  <a href="#contact">Contact</a>
</nav>

<div class="hero" id="home">
  <h2>Book Your Next Photo Session</h2>
  <p>Portraits, birthdays, seniors, daycare photos, events, weddings, and more.</p>
  <a href="#booking" class="btn">Book Now</a>
  <a href="#clientportal" class="btn">View & Pay For Photos</a>
</div>

<section id="sessions">
  <h2>Photography Services</h2>
  <div class="grid">
    <div class="card">
      <h3>Portrait Sessions</h3>
      <p>Professional studio-style portraits for individuals, families, birthdays, maternity, and branding.</p>
    </div>

    <div class="card">
      <h3>Senior Photos</h3>
      <p>Clean, creative senior portraits with custom looks and fast turnaround.</p>
    </div>

    <div class="card">
      <h3>Daycare & School Photos</h3>
      <p>Fall photos, Christmas photos, Valentine’s photos, picture day galleries, parent ordering, and digital downloads.</p>
    </div>

    <div class="card">
      <h3>Events & Weddings</h3>
      <p>Event coverage, wedding photography, contracts, online galleries, and print ordering.</p>
    </div>
  </div>
</section>

<section id="gallery">
  <h2>Photo Gallery</h2>
  <p>Browse galleries by category.</p>

  <div class="grid">
    <div class="card">Birthday Gallery</div>
    <div class="card">Maternity Gallery</div>
    <div class="card">Senior Gallery</div>
    <div class="card">Family Gallery</div>
    <div class="card">Daycare Gallery</div>
    <div class="card">Event Gallery</div>
  </div>
</section>

<section id="booking">
  <h2>Book A Session</h2>
  <form>
    <input type="text" placeholder="Full Name" required />
    <input type="email" placeholder="Email Address" required />
    <input type="tel" placeholder="Phone Number" required />

    <select required>
      <option value="">Select Session Type</option>
      <option>Birthday Session</option>
      <option>Maternity Session</option>
      <option>Senior Session</option>
      <option>Family Session</option>
      <option>Branding Session</option>
      <option>Daycare Photos</option>
      <option>Event Photography</option>
      <option>Wedding Photography</option>
    </select>

    <input type="date" required />
    <input type="time" required />
    <textarea placeholder="Tell me what type of shoot you need"></textarea>

    <button class="btn" type="submit">Submit Booking Request</button>
  </form>
</section>

<section id="clientportal">
  <h2>Client Photo Portal</h2>
  <p>Clients can view photos, choose favorites, pay online, and download images once approved.</p>

  <div class="grid">
    <div class="card">
      <h3>View Photos</h3>
      <p>Clients log in to view their private photo gallery.</p>
    </div>

    <div class="card">
      <h3>Pay For Images</h3>
      <p>Clients can pay before final edits and downloads are released.</p>
    </div>

    <div class="card">
      <h3>Download Images</h3>
      <p>After payment, clients receive access to download their finished photos.</p>
    </div>

    <div class="card">
      <h3>Face Search</h3>
      <p>For school and daycare galleries, parents can search for their child’s photos.</p>
    </div>
  </div>
</section>

<section id="eventaccess">
  <h2>Event Access Page</h2>
  <p>Guests can scan a QR code at events, find their photos, and buy digital downloads or prints.</p>

  <div class="grid">
    <div class="card">Scan QR Code</div>
    <div class="card">Find Your Photos</div>
    <div class="card">Buy Digital Download</div>
    <div class="card">Order Prints</div>
  </div>
</section>

<section id="rewards">
  <h2>VIP Rewards Program</h2>
  <div class="grid">
    <div class="card">
      <h3>Points Tracker</h3>
      <p>Earn rewards every time you book.</p>
    </div>

    <div class="card">
      <h3>5th Session Complete</h3>
      <p>Track progress toward free or discounted sessions.</p>
    </div>

    <div class="card">
      <h3>Birthday Rewards</h3>
      <p>Special birthday rewards for loyal clients.</p>
    </div>

    <div class="card">
      <h3>Referral Bonuses</h3>
      <p>Earn credits and discounts when you refer new clients.</p>
    </div>
  </div>
</section>

<section id="calendar">
  <h2>Calendar</h2>
  <p>View upcoming sessions, delivery dates, events, daycare picture days, and available dates.</p>
</section>

<section id="contracts">
  <h2>Contracts & Forms</h2>
  <div class="grid">
    <div class="card">Photo Shoot Agreement</div>
    <div class="card">Model Release</div>
    <div class="card">Event Contract</div>
    <div class="card">Daycare Agreement</div>
    <div class="card">Wedding Contract</div>
  </div>
</section>

<section id="promotions">
  <h2>Current Promotions</h2>
  <div class="grid">
    <div class="card">Seasonal Sets</div>
    <div class="card">Limited Slots</div>
    <div class="card">Holiday Minis</div>
    <div class="card">Flash Sales</div>
  </div>
</section>

<section id="reviews">
  <h2>Reviews & Testimonials</h2>
  <p>Google reviews and client videos can be featured here.</p>
</section>

<section id="business">
  <h2>Business Management Dashboard</h2>
  <p>This section would be private for you only.</p>

  <div class="grid">
    <div class="card">Bookings</div>
    <div class="card">Revenue</div>
    <div class="card">Upcoming Shoots</div>
    <div class="card">Popular Sessions</div>
    <div class="card">Client Activity</div>
  </div>
</section>

<section id="contact">
  <h2>Contact</h2>
  <p>Ready to book? Text now.</p>
  <a href="sms:5135440225" class="btn">Text 513-544-0225</a>
</section>

<footer>
  <p>© 2026 T.A.P Studios. All Rights Reserved.</p>
</footer>

</body>
</html>
